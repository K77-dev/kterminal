{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#eeeeee",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#e5c07b"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#9d7cd8",
    "bold": true
  },
  "h1": { "prefix": "" },
  "h2": { "prefix": "" },
  "h3": { "prefix": "" },
  "h4": { "prefix": "" },
  "h5": { "prefix": "" },
  "h6": { "prefix": "" },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#e5c07b",
    "italic": true
  },
  "strong": {
    "color": "#f5a742",
    "bold": true
  },
  "hr": {
    "color": "#808080"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#fab283"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#56b6c2"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#56b6c2",
    "underline": true
  },
  "link_text": {
    "color": "#fab283",
    "bold": true
  },
  "image": {
    "color": "#fab283",
    "underline": true
  },
  "image_text": {
    "color": "#56b6c2",
    "format": "image: {{.text}}"
  },
  "code": {
    "color": "#7fd88f",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "color": "#eeeeee",
    "margin": 2,
    "chroma": {
      "text": { "color": "#eeeeee" },
      "error": { "color": "#e06c75" },
      "comment": { "color": "#808080" },
      "comment_preproc": { "color": "#808080" },
      "keyword": { "color": "#9d7cd8" },
      "keyword_type": { "color": "#e5c07b" },
      "keyword_constant": { "color": "#f5a742" },
      "keyword_declaration": { "color": "#9d7cd8" },
      "name": { "color": "#eeeeee" },
      "name_function": { "color": "#fab283" },
      "name_class": { "color": "#e5c07b" },
      "name_builtin": { "color": "#56b6c2" },
      "name_variable": { "color": "#e06c75" },
      "name_attribute": { "color": "#fab283" },
      "name_tag": { "color": "#e06c75" },
      "string": { "color": "#7fd88f" },
      "string_char": { "color": "#7fd88f" },
      "number": { "color": "#f5a742" },
      "operator": { "color": "#56b6c2" },
      "punctuation": { "color": "#eeeeee" }
    }
  },
  "table": {
    "center_separator": "+",
    "column_separator": "|",
    "row_separator": "-"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
