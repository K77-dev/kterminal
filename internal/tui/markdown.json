{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#eae4d8",
    "margin": 3
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#8e8878",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#eae4d8",
    "bold": true
  },
  "h1": { "prefix": "" },
  "h2": { "prefix": "" },
  "h3": { "prefix": "" },
  "h4": { "prefix": "" },
  "h5": { "prefix": "" },
  "h6": { "prefix": "" },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#c9c2b2",
    "italic": true
  },
  "strong": {
    "color": "#f0a83f",
    "bold": true
  },
  "hr": {
    "color": "#8e8878"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#f0a83f"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#8e8878"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#8ec7ac",
    "underline": true
  },
  "link_text": {
    "color": "#eae4d8",
    "bold": true
  },
  "image": {
    "color": "#8ec7ac",
    "underline": true
  },
  "image_text": {
    "color": "#8e8878",
    "format": "image: {{.text}}"
  },
  "code": {
    "color": "#8ec7ac",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "color": "#eae4d8",
    "margin": 2,
    "chroma": {
      "text": { "color": "#eae4d8" },
      "error": { "color": "#e2655f" },
      "comment": { "color": "#8e8878", "italic": true },
      "comment_preproc": { "color": "#8e8878" },
      "keyword": { "color": "#eae4d8", "bold": true },
      "keyword_type": { "color": "#c9a268" },
      "keyword_constant": { "color": "#f0a83f" },
      "keyword_declaration": { "color": "#eae4d8", "bold": true },
      "name": { "color": "#eae4d8" },
      "name_function": { "color": "#c9a268" },
      "name_class": { "color": "#c9a268" },
      "name_builtin": { "color": "#8ec7ac" },
      "name_variable": { "color": "#eae4d8" },
      "name_attribute": { "color": "#c9a268" },
      "name_tag": { "color": "#d98a8a" },
      "string": { "color": "#8ec7ac" },
      "string_char": { "color": "#8ec7ac" },
      "number": { "color": "#f0a83f" },
      "operator": { "color": "#8e8878" },
      "punctuation": { "color": "#eae4d8" }
    }
  },
  "table": {
    "center_separator": "+",
    "column_separator": "|",
    "row_separator": "-",
    "color": "#8e8878"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n↳ ",
    "color": "#8e8878"
  },
  "html_block": {},
  "html_span": {}
}
